{
  "name": "poc-mcp-appium",
  "version": "1.0.0",
  "description": "POC de uso do MCP oficial do Appium (appium-mcp) para mapear elementos e gerar testes CodeceptJS + TypeScript",
  "main": "index.js",
  "scripts": {
    "clear": "rm -rf ./output/*",
    "start:appium": "appium --base-path /wd/hub --allow-insecure chromedriver_autodownload",
    "start:appium-inspector": "appium",
    "gt": "npx codeceptjs gt",
    "gpo": "npx codeceptjs gpo",
    "app:install": "adb install -r ./app/wdio-native-demo-app.apk",
    "app:uninstall": "adb uninstall com.wdiodemoapp",
    "test": "npx dotenv -e .env.app -- codeceptjs run -c ./codecept.conf.ts --steps",
    "test:tags": "npx dotenv -e .env.app -- codeceptjs run -c ./codecept.conf.ts --steps --grep",
    "test:poc": "npx dotenv -e .env.app -- codeceptjs run -c ./codecept.conf.ts --steps --grep '@poc'",
    "test:bs": "RUN_ON=browserstack npx dotenv -e .env.app -- codeceptjs run -c ./codecept.conf.ts --steps --grep",
    "test:bs:now": "RUN_ON=browserstack BS_BUILD=\"run-$(date +%Y%m%d-%H%M)\" npx dotenv -e .env.app -- codeceptjs run -c ./codecept.conf.ts --steps --grep",
    "bs:upload": "npx dotenv -e .env.app -- sh -c 'curl -u \"$BS_USER:$BS_KEY\" -X POST https://api-cloud.browserstack.com/app-automate/upload -F \"file=@./app/$APK_NAME\"'",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.1",
    "@types/chai": "^5.2.2",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "appium": "^2.19.0",
    "appium-mcp": "^1.94.0",
    "appium-uiautomator2-driver": "^4.2.8",
    "chai": "^5.3.1",
    "codeceptjs": "^3.7.4",
    "dotenv": "^17.2.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webdriverio": "^9.19.1"
  }
}
